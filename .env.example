# Copy this file to .env (cp .env.example .env). .env is not committed to git.

# Used by docker-compose.yml to create the database
POSTGRES_USER=week6
POSTGRES_PASSWORD=week6_dev_password
POSTGRES_DB=week6
POSTGRES_PORT=5432

# Used by the FastAPI app to connect (must match the values above)
DATABASE_URL=postgresql+psycopg://week6:week6_dev_password@localhost:5432/week6
